<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>173b3eb5-ddfd-4513-93b1-7ba24fc4eed5</groupId>
	<!-- <groupId>3a209eb5-371f-4b87-aaa2-19c539592cea</groupId>  -->
	<!-- <groupId>acda9d4d-1bfb-4b44-9b48-6f8f49157bbd</groupId> -->
	<artifactId>datablind-policy</artifactId>
	<version>1.2.8</version>
	<name>ZTensor DataBlind Policy - Mule 4, Java 17</name>
    <description>ZTensor DataBlind Policy for Mule 4, Java 17 - Sensitive Data Protection </description>

	<packaging>mule-policy</packaging>

	<properties>
		<mule.maven.plugin.version>4.5.0</mule.maven.plugin.version>
		<mule.deploy.plugin.version>3.1.1</mule.deploy.plugin.version>
		<exchange.url>https://maven.anypoint.mulesoft.com/api/v1/organizations/${project.groupId}/maven</exchange.url>
		<http.policy.transform.extension>3.2.0</http.policy.transform.extension>
		<securePropertyModuleVersion>1.2.7</securePropertyModuleVersion>
		<!-- Datablind Connector is expected to be in the same exchange the Datablind policy is 
		 deployed, Make sure the project.groupId is the same as the Datablind connector's exchange group id -->
		<!-- Datablind connector version -->
		<!-- <datablind.version>1.0.0</datablind.version>
		<datablind.connector.groupId>org.ztensor.connectors</datablind.connector.groupId> -->
		<datablind.version>1.5.3</datablind.version>
		<!-- <datablind.connector.groupId>3a209eb5-371f-4b87-aaa2-19c539592cea</datablind.connector.groupId> -->
		<datablind.connector.groupId>173b3eb5-ddfd-4513-93b1-7ba24fc4eed5</datablind.connector.groupId>
	</properties>
	<dependencies>
		<dependency>
			<groupId>com.mulesoft.anypoint</groupId>
			<artifactId>mule-http-policy-transform-extension</artifactId>
			<version>${http.policy.transform.extension}</version>
			<classifier>mule-plugin</classifier>
			<!-- HTTP Connector is excluded to avoid packaging it with the policy, since the application's HTTP connector is used -->
			<exclusions>
				<exclusion>
					<groupId>org.mule.connectors</groupId>
					<artifactId>mule-http-connector</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.mule.connectors</groupId>
			<artifactId>mule-http-connector</artifactId>
			<version>1.9.0</version>
			<classifier>mule-plugin</classifier>
		</dependency>
		<dependency>
			<groupId>com.mulesoft.modules</groupId>
			<artifactId>mule-secure-configuration-property-module</artifactId>
			<version>${securePropertyModuleVersion}</version>
			<classifier>mule-plugin</classifier>
		</dependency>
		<!-- <dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>mule-datablind-connector</artifactId>
			<version>${datablind.version}</version>
			<classifier>mule-plugin</classifier>
		</dependency> -->

		<dependency>
			<groupId>${datablind.connector.groupId}</groupId>
			<artifactId>mule-datablind-connector</artifactId>
			<version>${datablind.version}</version>
			<classifier>mule-plugin</classifier>
		  </dependency>

	</dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>org.mule.tools.maven</groupId>
				<artifactId>mule-maven-plugin</artifactId>
				<version>${mule.maven.plugin.version}</version>
				<extensions>true</extensions>
				<configuration>
					<additionalPluginDependencies>
						<plugin>
							<groupId>${datablind.connector.groupId}</groupId>
							<artifactId>mule-datablind-connector</artifactId>
							<additionalDependencies>
								<dependency>
									<groupId>com.ztensor</groupId>
									<artifactId>datacrypt</artifactId>
									<version>4.3.3</version>
								</dependency>
							</additionalDependencies>
						</plugin>
					</additionalPluginDependencies>
					<classifier>policy</classifier>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-deploy-plugin</artifactId>
				<!--   <version>${mule.deploy.plugin.version}</version> -->
				<executions>
					<execution>
						<id>upload-template</id>
						<phase>deploy</phase>
						<goals>
							<goal>deploy-file</goal>
						</goals>
						<configuration>
							<repositoryId>exchange-server</repositoryId>
							<url>${exchange.url}</url>
							<file>${project.basedir}/${project.artifactId}.yaml</file>
							<generatePom>false</generatePom>
							<groupId>${project.groupId}</groupId>
							<artifactId>${project.artifactId}</artifactId>
							<version>${project.version}</version>
							<packaging>yaml</packaging>
							<classifier>policy-definition</classifier>
						</configuration>
					</execution>
					<execution>
						<id>upload-icon</id>
						<phase>deploy</phase>
						<goals>
							<goal>deploy-file</goal>
						</goals>
						<configuration>
							<repositoryId>exchange-server</repositoryId>
							<url>${exchange.url}</url>
							<file>${project.basedir}/icon/icon.svg</file>
							<generatePom>false</generatePom>
							<groupId>${project.groupId}</groupId>
							<artifactId>${project.artifactId}</artifactId>
							<version>${project.version}</version>
							<packaging>svg</packaging>
							<classifier>icon</classifier>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<repositories>
		<repository>
			<id>datablindrepo</id>
			<name>GitHub OWNER Apache Maven Packages</name>
			<url>https://maven.pkg.github.com/datablind/datacrypt</url>
		</repository>
		<repository>
			<id>anypoint-exchange-v3</id>
			<name>Anypoint Exchange V3</name>
			<url>https://maven.anypoint.mulesoft.com/api/v3/maven</url>
			<layout>default</layout>
		</repository>
		<repository>
			<id>anypoint-exchange-v2</id>
			<name>Anypoint Exchange V2</name>
			<url>https://maven.anypoint.mulesoft.com/api/v2/maven</url>
			<layout>default</layout>
		</repository>

	</repositories>

	<distributionManagement>
		<repository>
			<id>exchange-server</id>
			<name>Corporate Repository</name>
			<url>${exchange.url}</url>
			<layout>default</layout>
		</repository>
	</distributionManagement>

	<pluginRepositories>
		<pluginRepository>
			<id>mule-plugin</id>
			<name>Mule Repository</name>
			<url>https://repository.mulesoft.org/nexus/content/repositories/public/</url>
		</pluginRepository>
		<pluginRepository>
			<id>mulesoft-releases</id>
			<name>MuleSoft Releases Repository</name>
			<url>https://repository.mulesoft.org/releases/</url>
			<layout>default</layout>
		</pluginRepository>
	</pluginRepositories>
</project>
